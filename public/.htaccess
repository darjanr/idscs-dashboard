# Apache / LiteSpeed config for the static site on cPanel hosting.
# Security headers + caching are ported from the old netlify.toml — without them
# the site loses its CSP/HSTS and cache policy. This file lives in public/ so
# Astro copies it into dist/ on every build and it deploys with the site.
# (nginx ignores .htaccess — see deploy/nginx.conf for a root/nginx server.)

# ---- Security headers ------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  # ---- Caching (path-based, Apache 2.4 / LiteSpeed) ----
  # Content-hashed Astro assets are immutable; data JSON revalidates hourly.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/data/#">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </ElseIf>
</IfModule>

# ---- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---- Routing / hardening ---------------------------------------------------
# Astro builds directory-format pages (/questions/ -> /questions/index.html);
# mod_dir serves index.html for a directory automatically.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
