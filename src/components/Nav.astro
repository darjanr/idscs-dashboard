---
import { t, languages, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = lang === "mk" ? "" : `/${lang}`;

const links = [
  { href: `${base}/questions`, label: t(lang, "nav.questions") },
  { href: `${base}/mymp`, label: t(lang, "nav.mymp") },
  { href: `${base}/offices`, label: t(lang, "nav.offices") },
  { href: `${base}/profile`, label: t(lang, "nav.profile") },
  { href: `${base}/methodology`, label: t(lang, "nav.methodology") },
];

const currentPath = Astro.url.pathname;

const otherLang = lang === "mk" ? "al" : "mk";
const otherPath = lang === "mk"
  ? `/al${currentPath}`
  : currentPath.replace(/^\/al/, "") || "/";
---

<header class="bg-navy-900 text-white shadow-lg" style="background-color: #1a2e5a;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={base || "/"} class="flex items-center gap-3 hover:opacity-90">
        <img
          src="/sobranie-logo.svg"
          alt="Собрание на РСМ"
          class="h-10 w-auto object-contain"
          loading="eager"
        />
        <span class="hidden sm:block text-white font-semibold text-base leading-tight">
          Пратеничка<br />активност
        </span>
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Главна навигација" class="hidden md:flex items-center gap-1">
        {links.map(link => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded text-sm font-medium transition-colors ${
              currentPath.startsWith(link.href) && link.href !== "/"
                ? "bg-white/20 text-white"
                : "text-white/80 hover:text-white hover:bg-white/10"
            }`}
          >
            {link.label}
          </a>
        ))}
        <a
          href={otherPath}
          class="ml-4 px-3 py-1.5 rounded border border-white/40 text-sm text-white/80 hover:text-white hover:border-white transition-colors"
          aria-label="Смени јазик"
        >
          {languages[otherLang]}
        </a>
      </nav>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded text-white/80 hover:text-white hover:bg-white/10"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Отвори мени"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4" aria-label="Мобилна навигација">
      {links.map(link => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded text-sm text-white/80 hover:text-white hover:bg-white/10"
        >
          {link.label}
        </a>
      ))}
      <a
        href={otherPath}
        class="block mt-2 px-3 py-2 rounded text-sm text-white/80 hover:text-white hover:bg-white/10"
      >
        {languages[otherLang]}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });
</script>
