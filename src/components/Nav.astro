---
import { t, languages, LANGS, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = lang === "mk" ? "" : `/${lang}`;

// Language switcher: keep the current page, swap the language prefix.
const stripLang = (p: string) => {
  const stripped = p.replace(/^\/(al|en)(?=\/|$)/, "");
  return stripped === "" ? "/" : stripped;
};
const basePath = stripLang(Astro.url.pathname);
const langHref = (code: Lang) =>
  code === "mk" ? basePath : basePath === "/" ? `/${code}` : `/${code}${basePath}`;

const mainLinks = [
  { href: `${base}/questions`, label: t(lang, "nav.questions") },
  { href: `${base}/mymp`, label: t(lang, "nav.mymp") },
  { href: `${base}/offices`, label: t(lang, "nav.offices") },
  { href: `${base}/profile`, label: t(lang, "nav.profile") },
];

// "За проектот" dropdown group
const aboutLinks = [
  { href: `${base}/project`, label: t(lang, "nav.project") },
  { href: `${base}/about`, label: t(lang, "nav.about") },
  { href: `${base}/methodology`, label: t(lang, "nav.methodology") },
];

const currentPath = Astro.url.pathname;
const aboutActive = aboutLinks.some(l => currentPath.startsWith(l.href));
---

<header class="bg-navy-900 text-white shadow-lg" style="background-color: #1a2e5a;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={base || "/"} class="flex items-center hover:opacity-90" aria-label={t(lang, "nav.home")}>
        <span class="inline-flex items-center bg-white rounded-md px-2.5 py-1.5 shadow-sm">
          <img
            src="/logos/ddi.png"
            alt="Digital Democracy Initiative"
            class="h-6 w-auto"
            loading="eager"
          />
        </span>
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Главна навигација" class="hidden md:flex items-center gap-1">
        {mainLinks.map(link => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded text-sm font-medium transition-colors ${
              currentPath.startsWith(link.href) && link.href !== "/"
                ? "bg-white/20 text-white"
                : "text-white/80 hover:text-white hover:bg-white/10"
            }`}
          >
            {link.label}
          </a>
        ))}

        <!-- separator between functional tabs and the About group -->
        <span class="w-px h-5 bg-white/15 mx-2" aria-hidden="true"></span>

        <!-- За проектот dropdown -->
        <div class="relative group">
          <button
            type="button"
            class={`px-3 py-2 rounded text-sm font-medium transition-colors inline-flex items-center gap-1 ${
              aboutActive ? "bg-white/20 text-white" : "text-white/80 hover:text-white hover:bg-white/10"
            }`}
            aria-haspopup="true"
          >
            {t(lang, "nav.project")}
            <svg class="w-3 h-3 opacity-70" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 4.5 6 7.5 9 4.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="absolute right-0 top-full pt-2 hidden group-hover:block group-focus-within:block z-50">
            <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-1 min-w-[210px]">
              {aboutLinks.map(link => (
                <a
                  href={link.href}
                  class={`block px-4 py-2 text-sm transition-colors ${
                    currentPath.startsWith(link.href)
                      ? "text-teal-700 bg-teal-50 font-medium"
                      : "text-gray-700 hover:bg-gray-50 hover:text-teal-700"
                  }`}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
        <!-- Language switcher -->
        <span class="w-px h-5 bg-white/15 mx-2" aria-hidden="true"></span>
        <div class="flex items-center gap-0.5" role="group" aria-label={t(lang, "nav.language")}>
          {LANGS.map(code => (
            <a
              href={langHref(code)}
              hreflang={code === "al" ? "sq" : code}
              class={`px-2 py-1 rounded text-xs font-semibold transition-colors ${
                lang === code ? "bg-white text-[#1a2e5a]" : "text-white/70 hover:text-white hover:bg-white/10"
              }`}
              aria-current={lang === code ? "true" : undefined}
            >
              {languages[code]}
            </a>
          ))}
        </div>
      </nav>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded text-white/80 hover:text-white hover:bg-white/10"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Отвори мени"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4" aria-label="Мобилна навигација">
      {mainLinks.map(link => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded text-sm text-white/80 hover:text-white hover:bg-white/10"
        >
          {link.label}
        </a>
      ))}
      <p class="px-3 pt-3 pb-1 text-xs font-semibold uppercase tracking-wide text-white/40">{t(lang, "nav.project")}</p>
      {aboutLinks.map(link => (
        <a
          href={link.href}
          class="block px-3 py-2 pl-5 rounded text-sm text-white/80 hover:text-white hover:bg-white/10"
        >
          {link.label}
        </a>
      ))}
      <p class="px-3 pt-3 pb-1 text-xs font-semibold uppercase tracking-wide text-white/40">{t(lang, "nav.language")}</p>
      <div class="flex items-center gap-1 px-3 pt-1">
        {LANGS.map(code => (
          <a
            href={langHref(code)}
            hreflang={code === "al" ? "sq" : code}
            class={`px-3 py-1.5 rounded text-sm font-semibold transition-colors ${
              lang === code ? "bg-white text-[#1a2e5a]" : "text-white/70 hover:text-white hover:bg-white/10"
            }`}
            aria-current={lang === code ? "true" : undefined}
          >
            {languages[code]}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });
</script>
