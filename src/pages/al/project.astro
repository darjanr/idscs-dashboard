---
import Layout from "../../layouts/Layout.astro";
import { t, dict, type Lang } from "../../i18n";

const lang: Lang = "al";
const d = dict(lang);
---

<Layout title={t(lang, "nav.project")} lang={lang}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">{t(lang, "nav.project")}</h1>
  </div>

  <div class="max-w-3xl space-y-5 text-gray-700 leading-relaxed">
    <p>{d.project.p1}</p>
    <p>{d.project.p2}</p>
    <p>{d.project.p3}</p>
  </div>
</Layout>
