---
import Layout from "../../layouts/Layout.astro";
import { t, dict, type Lang } from "../../i18n";

const lang: Lang = "al";
const d = dict(lang);
---

<Layout title={t(lang, "nav.about")} lang={lang}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">{t(lang, "nav.about")}</h1>
  </div>

  <div class="max-w-3xl text-gray-700 leading-relaxed space-y-4">
    <p>{d.about.p1}</p>
    <p>{d.about.p2}</p>
    <p>{d.about.p3}</p>
    <p>{d.about.goalsIntro}</p>
    <ul class="list-disc pl-6 space-y-1">
      {d.about.goals.map(g => <li>{g}</li>)}
    </ul>
  </div>
</Layout>
