---
import Layout from "../../layouts/Layout.astro";
import { t, dict, type Lang } from "../../i18n";
import meta from "../../../public/data/meta.json";

const lang: Lang = "al";
const d = dict(lang);

const metaBySource = [
  meta.sources.questions,
  meta.sources.mymp,
  meta.sources.kancelarii,
];
const sources = d.methodology.sources.map((s, i) => ({
  name: s.name,
  notes: s.notes,
  format: i === 0 ? "JSON" : "XLSX",
  lastUpdated: metaBySource[i].lastPortalUpdate,
  records: metaBySource[i].records,
}));

const PORTAL = "https://opendata.sobranie.mk";
const dateLocale = lang === "al" ? "sq-AL" : lang === "en" ? "en-GB" : "mk-MK";
---

<Layout title={t(lang, "methodology.title")} lang={lang}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">{t(lang, "methodology.title")}</h1>
    <p class="text-gray-500 mt-1">{t(lang, "methodology.subtitle")}</p>
  </div>

  <div class="space-y-8 max-w-3xl">
    {sources.map(s => (
      <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-2 mb-4">
          <div>
            <h2 class="font-semibold text-gray-900 text-lg">{s.name}</h2>
            <p class="text-sm text-gray-500 mt-0.5">{t(lang, "methodology.formatLabel")}: {s.format} · {s.records} {t(lang, "methodology.recordsLabel")}</p>
          </div>
          <div class="text-right">
            <p class="text-xs text-gray-400">{t(lang, "methodology.lastPortalUpdate")}</p>
            <p class="text-sm font-semibold text-gray-700">{s.lastUpdated}</p>
          </div>
        </div>
        <ul class="space-y-2">
          {s.notes.map(note => (
            <li class="flex gap-2 text-sm text-gray-600">
              <span class="text-gray-400 shrink-0">→</span>
              <span>{note}</span>
            </li>
          ))}
        </ul>
        <a
          href={PORTAL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-4 text-sm text-teal-600 hover:text-teal-800 underline"
        >
          {t(lang, "common.source")}: {PORTAL}
        </a>
      </div>
    ))}

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
      <h2 class="font-semibold text-gray-900 text-lg mb-4">{t(lang, "methodology.activeAssemblyTitle")}</h2>
      <p class="text-sm text-gray-600 mb-3">{t(lang, "methodology.activeAssemblyP1")}</p>
      <p class="text-sm text-gray-600">{t(lang, "methodology.activeAssemblyP2")}</p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
      <h2 class="font-semibold text-gray-900 text-lg mb-4">{t(lang, "methodology.joinTitle")}</h2>
      <p class="text-sm text-gray-600 mb-3">{t(lang, "methodology.joinP1")}</p>
      <p class="text-sm text-gray-600">{t(lang, "methodology.joinP2")}</p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
      <h2 class="font-semibold text-gray-900 text-lg mb-4">{t(lang, "methodology.refreshTitle")}</h2>
      <p class="text-sm text-gray-600 mb-3">{t(lang, "methodology.refreshIntro")}</p>
      <ol class="space-y-1 text-sm text-gray-600 list-decimal list-inside">
        <li>{t(lang, "methodology.refreshStep1pre")} <code class="bg-gray-100 px-1 rounded">fetch_data.py</code> {t(lang, "methodology.refreshStep1post")}</li>
        <li>{t(lang, "methodology.refreshStep2pre")} <code class="bg-gray-100 px-1 rounded">scripts/process.py</code> {t(lang, "methodology.refreshStep2post")}</li>
        <li>{t(lang, "methodology.refreshStep3")}</li>
      </ol>
      <p class="text-sm text-gray-400 mt-4">
        {t(lang, "methodology.lastProcessedLabel")} {new Date(meta.lastProcessed).toLocaleDateString(dateLocale, { dateStyle: "long" })}
      </p>
    </div>
  </div>
</Layout>
