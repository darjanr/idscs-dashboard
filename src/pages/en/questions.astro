---
import Layout from "../../layouts/Layout.astro";
import QuestionsExplorer from "../../components/QuestionsExplorer";
import { t, type Lang } from "../../i18n";
import questions from "../../../public/data/questions.json";
import meta from "../../../public/data/meta.json";
import qi18n from "../../../public/data/questions_i18n.json";

const lang: Lang = "en";
const dateLocale = lang === "al" ? "sq-AL" : lang === "en" ? "en-GB" : "mk-MK";
const lastUpdate = new Date(meta.sources.questions.lastPortalUpdate).toLocaleDateString(dateLocale, { dateStyle: "long" });
---

<Layout title={t(lang, "questions.title")} lang={lang}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">{t(lang, "questions.title")}</h1>
    <p class="text-gray-500 mt-1">{t(lang, "questions.subtitle")}</p>
    <p class="text-sm text-gray-400 mt-1">{t(lang, "questions.lastUpdate")} <span class="font-semibold text-gray-600">{lastUpdate}</span></p>
  </div>
  <QuestionsExplorer questions={questions} lang={lang} qi18n={qi18n} client:load />
</Layout>
