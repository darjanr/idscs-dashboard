---
import Layout from "../layouts/Layout.astro";
import { t } from "../i18n";
const lang = "mk";

const kpis = [
  { value: "657", label: "Пратенички прашања", note: "590 одговорени" },
  { value: "120", label: "Пратеници",          note: "Активен состав 2024–2028" },
  { value: "46",  label: "Канцеларии",          note: "за контакт со граѓани" },
];

const modules = [
  {
    href: "/questions",
    label: t(lang, "nav.questions"),
    desc: "Прашања поставени до институции, министерства и независни тела во Собранието 2024–2028",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="14" x2="13" y2="14"/></svg>`,
    accent: "#0d9488",
  },
  {
    href: "/mymp",
    label: t(lang, "nav.mymp"),
    desc: "Присуство, дискусии, закони и амандмани — активност на секој пратеник",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    accent: "#0d9488",
  },
  {
    href: "/offices",
    label: t(lang, "nav.offices"),
    desc: "Граѓански случаи, состаноци и иницијативи по канцеларии на пратеници",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    accent: "#1a2e5a",
  },
  {
    href: "/profile",
    label: t(lang, "nav.profile"),
    desc: "Обединет профил на пратеник: парламентарна активност и граѓански случаи",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    accent: "#1a2e5a",
  },
];
---

<Layout title="Парламентарни отворени податоци" lang={lang}>
  <!-- Full-bleed navy hero -->
  <section
    slot="hero"
    style="
      background-color: #1a2e5a;
      background-image:
        radial-gradient(ellipse at 10% 60%, rgba(13,148,136,0.18) 0%, transparent 55%),
        radial-gradient(ellipse at 90% 10%, rgba(255,255,255,0.06) 0%, transparent 40%),
        repeating-linear-gradient(0deg,   transparent, transparent 59px, rgba(255,255,255,0.025) 59px, rgba(255,255,255,0.025) 60px),
        repeating-linear-gradient(90deg,  transparent, transparent 59px, rgba(255,255,255,0.025) 59px, rgba(255,255,255,0.025) 60px);
      padding-bottom: 5rem;
    "
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-4 text-center">
      <!-- Parliament illustration -->
      <img
        src="/parliament.svg"
        alt="Собрание на Република Северна Македонија"
        class="mx-auto h-20 sm:h-24 w-auto mb-6 opacity-95"
        loading="eager"
      />
      <!-- Badge -->
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wide mb-6"
            style="background:rgba(13,148,136,0.25); color:#5eead4; border:1px solid rgba(13,148,136,0.4);">
        Собрание на Република Северна Македонија · 2024–2028
      </span>

      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3 leading-tight">
        Интерактивен панел на отворени податоци
      </h1>
      <p class="text-xl sm:text-2xl text-white/70 max-w-2xl mx-auto mb-14 leading-snug">
        на Собранието на Република Северна Македонија
      </p>

      <!-- KPI strip -->
      <div class="inline-grid grid-cols-3 divide-x divide-white/10 rounded-2xl overflow-hidden"
           style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1);">
        {kpis.map(k => (
          <div class="px-8 py-5 text-center">
            <p class="text-3xl font-bold text-white">{k.value}</p>
            <p class="text-sm font-medium text-white/80 mt-0.5">{k.label}</p>
            <p class="text-xs text-white/40 mt-0.5">{k.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Module cards — float up over the hero bottom -->
  <div class="-mt-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {modules.map(m => (
        <a
          href={m.href}
          class="group bg-white rounded-2xl border border-gray-200 p-6 shadow-md hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-teal-500"
        >
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 transition-colors"
               style={`background-color: ${m.accent}1a; color: ${m.accent};`}
               set:html={m.icon}
          />
          <h2 class="font-semibold text-gray-900 mb-1.5 group-hover:text-teal-700 transition-colors">{m.label}</h2>
          <p class="text-sm text-gray-500 leading-relaxed">{m.desc}</p>
          <span class="inline-flex items-center gap-1 mt-4 text-xs font-semibold" style={`color:${m.accent};`}>
            Отвори <svg viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3"><path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/></svg>
          </span>
        </a>
      ))}
    </div>

    <!-- Disclaimer — plain text, not a card -->
    <div class="max-w-3xl mx-auto mt-12 text-center space-y-3">
      <p class="text-sm text-gray-500 leading-relaxed">
        Оваа активност е поддржана од Иницијативата за дигитална демократија на CIVICUS
        (CIVICUS Digital Democracy Initiative – DDI), а ја спроведува Институтот за демократија
        „Социетас Цивилис“ – Скопје.
      </p>
      <p class="text-sm text-gray-500 leading-relaxed">
        Контролната табла користи податоци преземени од
        <a href="https://opendata.sobranie.mk" target="_blank" rel="noopener noreferrer"
           class="text-teal-700 underline hover:text-teal-900">Порталот за отворени податоци на Собранието на Република Северна Македонија</a>,
        во формата и содржината во која тие се објавени од Собранието. Институтот за демократија
        ги презентира и визуелизира достапните податоци, без дополнителна измена или верификација
        на нивната содржина.
      </p>
    </div>
  </div>
</Layout>
