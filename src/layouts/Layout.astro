---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { getLangFromURL, t, type Lang } from "../i18n";

interface Props {
  title: string;
  lang?: Lang;
}

const { title, lang: langProp } = Astro.props;
const lang: Lang = langProp ?? getLangFromURL(Astro.url);

// --- SEO / social metadata -------------------------------------------------
const fullTitle = `${title} — Собрание Отворени Податоци`;
const description = t(lang, "meta.description");
const siteName = t(lang, "meta.siteName");
// <html lang> + og:locale per language (AL uses the ISO code `sq` for Albanian).
const htmlLang = lang === "al" ? "sq" : lang === "en" ? "en" : "mk";
const ogLocale = lang === "al" ? "sq_AL" : lang === "en" ? "en_US" : "mk_MK";
// Language-swapped paths for canonical + hreflang alternates (mirrors Nav.astro).
const stripLang = (p: string) => {
  const s = p.replace(/^\/(al|en)(?=\/|$)/, "");
  return s === "" ? "/" : s;
};
const basePath = stripLang(Astro.url.pathname);
const langHref = (code: Lang) =>
  code === "mk" ? basePath : basePath === "/" ? `/${code}` : `/${code}${basePath}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
// Fixed social-share card title/description (client-specified) used for og/twitter.
const shareTitle = "Пратеничка активност - интерактивен панел";
const shareDescription = "Интерактивен панел на отворени податоци за активноста на пратениците во Собранието на Република Северна Македонија - 2024 - 2028.";

// Google Analytics 4 — set the Measurement ID (G-XXXXXXXXXX) to enable tracking.
// Empty = disabled (no scripts load). Google's domains are allowlisted in the CSP
// (public/.htaccess). GA loads ONLY after the visitor accepts the consent banner
// (GDPR opt-in); the choice is remembered in localStorage under `ga-consent`.
const GA_ID = "G-K0NYDK258L";
const gaConsentScript = GA_ID ? `(function(){var K='ga-consent';function load(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=${GA_ID}';document.head.appendChild(s);window.dataLayer=window.dataLayer||[];function g(){dataLayer.push(arguments);}g('js',new Date());g('config','${GA_ID}');}var c=null;try{c=localStorage.getItem(K);}catch(e){}if(c==='granted'){load();return;}if(c==='denied'){return;}var b=document.getElementById('cookie-consent');if(!b)return;b.hidden=false;var a=document.getElementById('cookie-accept'),d=document.getElementById('cookie-decline');a&&a.addEventListener('click',function(){try{localStorage.setItem(K,'granted');}catch(e){}b.hidden=true;load();});d&&d.addEventListener('click',function(){try{localStorage.setItem(K,'denied');}catch(e){}b.hidden=true;});})();` : "";
const alternates = [
  { hreflang: "mk", href: new URL(langHref("mk"), Astro.site).href },
  { hreflang: "sq", href: new URL(langHref("al"), Astro.site).href },
  { hreflang: "en", href: new URL(langHref("en"), Astro.site).href },
  { hreflang: "x-default", href: new URL(langHref("mk"), Astro.site).href },
];

// Partner logos for the footer strip, in the order required by the visibility guidelines.
// `h` is a per-logo optical height (px) matched to the donor's reference lockup:
// the proportions were measured off that image (CIVICUS 1.0 : Metamorphosis 0.60 :
// TechSoup 0.28 : Digital Activism 0.57) so each mark reads at the same visual weight
// despite very different aspect ratios. IDSCS (our implementer mark, not in the
// reference) is harmonised alongside the Metamorphosis wordmark.
const partnerLogos = [
  { src: "/logos/civicus.png", alt: "CIVICUS", h: 50 },
  { src: "/logos/metamorphosis.png", alt: "Metamorphosis Foundation", h: 30 },
  { src: "/logos/techsoup.png", alt: "TechSoup", h: 14 },
  { src: "/logos/digital-activism.png", alt: "Digital Activism Program", h: 28 },
  { src: "/logos/idscs.png", alt: "Институт за демократија — Социетас Цивилис, Скопје", h: 30 },
];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical.href} />
    {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage.href} />
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <a href="#main" class="skip-link">{t(lang, "common.skipToContent")}</a>
    <Nav lang={lang} />
    {Astro.slots.has('hero') && <slot name="hero" />}
    <main id="main" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
    <footer class="mt-16 border-t border-gray-200 bg-white">
      <!-- Partner logos -->
      <div class="max-w-5xl mx-auto px-4 pt-10 pb-8">
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
          {partnerLogos.map(logo => (
            <div class="flex items-center justify-center">
              <img
                src={logo.src}
                alt={logo.alt}
                class="w-auto object-contain"
                style={`height: ${logo.h}px;`}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
      <div class="border-t border-gray-100 py-6 text-center text-sm text-gray-500">
        <p class="max-w-3xl mx-auto px-4 leading-relaxed">
          {t(lang, "footer.dataNotePre")}
          <a
            href="https://opendata.sobranie.mk"
            class="underline hover:text-gray-900"
            target="_blank"
            rel="noopener noreferrer"
          >{t(lang, "footer.portalName")}</a>{t(lang, "footer.dataNotePost")}
        </p>
      </div>
    </footer>

    {GA_ID && (
      <div id="cookie-consent" class="cookie-consent" hidden>
        <p class="cookie-consent__text">{t(lang, "consent.text")}</p>
        <div class="cookie-consent__actions">
          <button id="cookie-accept" type="button" class="cookie-consent__btn cookie-consent__btn--accept">{t(lang, "consent.accept")}</button>
          <button id="cookie-decline" type="button" class="cookie-consent__btn cookie-consent__btn--decline">{t(lang, "consent.decline")}</button>
        </div>
      </div>
      <script is:inline set:html={gaConsentScript}></script>
    )}

    <style is:global>
      .cookie-consent {
        position: fixed;
        inset: auto 0 0 0;
        z-index: 60;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.6rem 1.25rem;
        padding: 0.85rem 1rem;
        background: #1a2e5a;
        color: #fff;
        font-size: 0.875rem;
        box-shadow: 0 -2px 14px rgba(0, 0, 0, 0.18);
      }
      .cookie-consent[hidden] { display: none; }
      .cookie-consent__text { margin: 0; max-width: 60ch; line-height: 1.45; }
      .cookie-consent__actions { display: flex; gap: 0.5rem; flex-shrink: 0; }
      .cookie-consent__btn {
        border: 0;
        border-radius: 0.5rem;
        padding: 0.5rem 1.1rem;
        font: inherit;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.15s;
      }
      .cookie-consent__btn--accept { background: #0d9488; color: #fff; }
      .cookie-consent__btn--accept:hover { background: #0b8177; }
      .cookie-consent__btn--decline {
        background: transparent;
        color: #cbd5e1;
        border: 1px solid #475569;
      }
      .cookie-consent__btn--decline:hover { background: rgba(255, 255, 255, 0.08); }
    </style>
  </body>
</html>
