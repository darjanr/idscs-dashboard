---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { getLangFromURL, t, type Lang } from "../i18n";

interface Props {
  title: string;
  lang?: Lang;
}

const { title, lang: langProp } = Astro.props;
const lang: Lang = langProp ?? getLangFromURL(Astro.url);

// --- SEO / social metadata -------------------------------------------------
const fullTitle = `${title} — Собрание Отворени Податоци`;
const description = t(lang, "meta.description");
const siteName = t(lang, "meta.siteName");
// <html lang> + og:locale per language (AL uses the ISO code `sq` for Albanian).
const htmlLang = lang === "al" ? "sq" : lang === "en" ? "en" : "mk";
const ogLocale = lang === "al" ? "sq_AL" : lang === "en" ? "en_US" : "mk_MK";
// Language-swapped paths for canonical + hreflang alternates (mirrors Nav.astro).
const stripLang = (p: string) => {
  const s = p.replace(/^\/(al|en)(?=\/|$)/, "");
  return s === "" ? "/" : s;
};
const basePath = stripLang(Astro.url.pathname);
const langHref = (code: Lang) =>
  code === "mk" ? basePath : basePath === "/" ? `/${code}` : `/${code}${basePath}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
// Fixed social-share card title/description (client-specified) used for og/twitter.
const shareTitle = "Пратеничка активност - интерактивен панел";
const shareDescription = "Интерактивен панел на отворени податоци за активноста на пратениците во Собранието на Република Северна Македонија - 2024 - 2028.";

// Google Analytics 4 — set the Measurement ID (G-XXXXXXXXXX) to enable tracking.
// Empty = disabled (no scripts load). Google's domains are allowlisted in the CSP
// (public/.htaccess). Note: GA4 sets cookies — add a consent banner for GDPR.
const GA_ID = "G-K0NYDK258L";
const alternates = [
  { hreflang: "mk", href: new URL(langHref("mk"), Astro.site).href },
  { hreflang: "sq", href: new URL(langHref("al"), Astro.site).href },
  { hreflang: "en", href: new URL(langHref("en"), Astro.site).href },
  { hreflang: "x-default", href: new URL(langHref("mk"), Astro.site).href },
];

// Partner logos for the footer strip, in the order required by the visibility guidelines.
// `h` is a per-logo optical height (px) matched to the donor's reference lockup:
// the proportions were measured off that image (CIVICUS 1.0 : Metamorphosis 0.60 :
// TechSoup 0.28 : Digital Activism 0.57) so each mark reads at the same visual weight
// despite very different aspect ratios. IDSCS (our implementer mark, not in the
// reference) is harmonised alongside the Metamorphosis wordmark.
const partnerLogos = [
  { src: "/logos/civicus.png", alt: "CIVICUS", h: 50 },
  { src: "/logos/metamorphosis.png", alt: "Metamorphosis Foundation", h: 30 },
  { src: "/logos/techsoup.png", alt: "TechSoup", h: 14 },
  { src: "/logos/digital-activism.png", alt: "Digital Activism Program", h: 28 },
  { src: "/logos/idscs.png", alt: "Институт за демократија — Социетас Цивилис, Скопје", h: 30 },
];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical.href} />
    {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    {GA_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`}></script>
      </>
    )}
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <a href="#main" class="skip-link">{t(lang, "common.skipToContent")}</a>
    <Nav lang={lang} />
    {Astro.slots.has('hero') && <slot name="hero" />}
    <main id="main" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
    <footer class="mt-16 border-t border-gray-200 bg-white">
      <!-- Partner logos -->
      <div class="max-w-5xl mx-auto px-4 pt-10 pb-8">
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
          {partnerLogos.map(logo => (
            <div class="flex items-center justify-center">
              <img
                src={logo.src}
                alt={logo.alt}
                class="w-auto object-contain"
                style={`height: ${logo.h}px;`}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
      <div class="border-t border-gray-100 py-6 text-center text-sm text-gray-500">
        <p class="max-w-3xl mx-auto px-4 leading-relaxed">
          {t(lang, "footer.dataNotePre")}
          <a
            href="https://opendata.sobranie.mk"
            class="underline hover:text-gray-900"
            target="_blank"
            rel="noopener noreferrer"
          >{t(lang, "footer.portalName")}</a>{t(lang, "footer.dataNotePost")}
        </p>
      </div>
    </footer>
  </body>
</html>
